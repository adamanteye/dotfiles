# Terminal-adaptive ANSI16 / Base16-compatible colors.
# Use only default and color0..color15: no RGB values or fixed 256-color slots.
# No extended Base16 slots (color16..color21) or theme scripts are required.
# Changing the terminal palette also changes this theme, like Helix base16_terminal.
#
# Slots: 0 black, 1 red/error, 2 green/success/new, 3 yellow/warning/flagged,
#        4 blue, 5 magenta, 6 cyan, 7 white, 8 dim gray, 15 bright white.
# Normal text and backgrounds inherit the terminal defaults, including light themes.
# https://neomutt.org/guide/configuration.html#color

color attachment  color4 default
color bold        bold default default
color error       bold color1 default
color hdrdefault  color8 default
color indicator   reverse default default
color markers     color8 default
color normal      default default
color quoted      color6 default
color quoted1     color2 default
color quoted2     color4 default
color quoted3     color5 default
color quoted4     color3 default
color quoted5     color6 default
color search      color0 color3
color signature   color6 default
color status      color0 color7
color tilde       color8 default
color tree        color2 default
color underline   underline default default

color sidebar_divider    color7 default
color sidebar_new        color2 default
color sidebar_background default default
color sidebar_ordinary   default default
color sidebar_unread     color2 default
color sidebar_flagged    color3 default
color sidebar_highlight  reverse default default
color sidebar_indicator reverse default default

color index color2 default ~N
color index color6 default ~O
color index color4 default ~P
color index color3 default ~F
color index color5 default ~Q
color index color1 default ~=
color index color0 color6 ~T
color index color0 color1 ~D

color header color3 default "^(To:|From:)"
color header color2 default "^Subject:"
color header color6 default "^X-Spam-Status:"
color header color6 default "^Received:"

# Regex magic for URLs and hostnames
#
# Attention: BSD's regex has RE_DUP_MAX set to 255.
#
# Examples:
#   http://some-service.example.com
#   example.com
#   a.example.com
#   some-service.example.com
#   example.com/
#   example.com/datenschutz
#   file:///tmp/foo
#
# Non-examples:
#   1.1.1900
#   14.02.2022/24:00
#   23.59
#   w.l.o.g
#   team.its
color body color2 default "[a-z]{3,255}://[[:graph:]]*"
color body color2 default "([-[:alnum:]]+\\.)+([0-9]{1,3}|[-[:alpha:]]+)/[[:graph:]]*"
color body color2 default "([-[:alnum:]]+\\.){2,255}[-[:alpha:]]{2,10}"

# IPv4 and IPv6 stolen from https://stackoverflow.com/questions/53497/regular-expression-that-matches-valid-ipv6-addresses
color body color2 default "((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])"
color body color2 default "(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))"

# Mail addresses and mailto URLs
color body color3 default "[-a-z_0-9.%$]+@[-a-z_0-9.]+\\.[-a-z][-a-z]+"
color body color3 default "mailto:[-a-z_0-9.]+@[-a-z_0-9.]+"

# some simleys and stuff
color body color0 color3 "[;:]-*[)>(<lt;|]"
color body color15 default "\\*[- A-Za-z]+\\*"

color body color3 default "^-.*PGP.*-*"
color body color2 default "^gpg: Good signature from"
color body color1 default "^gpg: Can't.*$"
color body color3 default "^gpg: WARNING:.*$"
color body color1 default "^gpg: BAD signature from"
color body color1 default "^gpg: Note: This key has expired!"
color body color3 default "^gpg: There is no indication that the signature belongs to the owner."
color body color3 default "^gpg: can't handle these multiple signatures"
color body color3 default "^gpg: signature verification suppressed"
color body color3 default "^gpg: invalid node with packet of type"

color body color2 default "^Good signature from:"
color body color1 default "^.?BAD.? signature from:"
color body color2 default "^Verification successful"
color body color1 default "^Verification [^s][^[:space:]]*$"

color compose header            default default
color compose security_encrypt  color5 default
color compose security_sign     color4 default
color compose security_both     color2 default
color compose security_none     color3 default

